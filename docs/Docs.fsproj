<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="Site.fs" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Nacara.Core" />
        <PackageReference Include="Nacara.Plugin.Markdown" />
        <PackageReference Include="Nacara.Plugin.Highlight.TreeSitter" />
        <PackageReference Include="Nacara.Plugin.Search" />
        <PackageReference Include="Nacara.Plugin.Sitemap" />
        <PackageReference Include="Nacara.Plugin.Assets.LightningCss" />
        <PackageReference Include="Nacara.Plugin.Assets.Nuglify" />
        <PackageReference Include="Nacara.Plugin.Deploy.GitHubPages" />
        <PackageReference Include="Nacara.Plugin.LiveExample" />
        <PackageReference Include="Nacara.Plugin.FSharpApi" />
        <PackageReference Include="Nacara.Plugin.Changelog" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="../src/Fable.Ripple/Fable.Ripple.fsproj" />
        <ProjectReference Include="../src/Fable.Ripple.Dom/Fable.Ripple.Dom.fsproj" />
        <ProjectReference Include="../src/Fable.UrlParser/Fable.UrlParser.fsproj" />
        <ProjectReference Include="../src/Fable.Ripple.Form/Fable.Ripple.Form.fsproj" />
        <ProjectReference Include="../src/Fable.Ripple.Form.Plain/Fable.Ripple.Form.Plain.fsproj" />
        <ProjectReference Include="../demo/Demo.fsproj" />
        <PackageReference Include="Nacara.Theme.Default" />
    </ItemGroup>
</Project>
